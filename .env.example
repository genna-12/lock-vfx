# Modello delle variabili: copiare in `.env.local` e riempire quel che serve.
# Tutte sono facoltative — senza nessuna, `npm run dev` e `npm run build`
# funzionano e il sito si comporta come il sito vero alla radice di un
# dominio non ancora deciso.

# Dove abita il sito, SENZA barra finale (es. https://lockvfx.com). Vuoto =
# niente `canonical` e niente `og:url`: meglio tacere che dichiarare un
# indirizzo sbagliato. Quando il dominio c'è si riempie qui (in produzione:
# fra le variabili del progetto su Cloudflare Pages).
VITE_SITE_URL=

# 1 = questa è l'anteprima per i ragazzi, non il sito vero: le due pagine
# dichiarano `noindex, nofollow` e il build scrive `dist/_headers` con
# `X-Robots-Tag`. Al lancio si toglie la variabile e si spengono insieme.
VITE_PREVIEW=

# Sottocartella, con le barre a inizio e fine (es. /lock-vfx/), se il sito
# non sta alla radice del dominio — il caso di GitHub Pages. Vuoto = `/`.
VITE_BASE=

# EmailJS — chiavi del form dei contatti (le manda LockVFX).
# Copiare in `.env.local` e riempire. La public key è visibile nel bundle:
# nel pannello EmailJS va attivata l'allowlist del dominio del sito e un
# limite giornaliero, altrimenti il form è usabile da chiunque a nome nostro.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# Risposta automatica a chi scrive: opzionale, si attiva riempiendola.
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=

# Invio simulato, senza chiamare EmailJS: 1 = riesce, fail = fallisce.
# Senza chiavi vale 1 in sviluppo; in produzione l'invio fallisce, perché un
# form che finge di aver spedito è peggio di uno che lo dice.
VITE_EMAILJS_MOCK=1

# Interruttori dei video, già usati dal codice ma finora non scritti qui.
# `none` (default) = il file non c'è: niente `<source>`, resta il poster e
# nessun 404. Si accendono quando i video arrivano in `public/video`.
VITE_REEL=none
VITE_WORKS=none
