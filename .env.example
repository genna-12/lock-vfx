# EmailJS — chiavi del form dei contatti (le manda LockVFX).
# Copiare in `.env.local` e riempire. La public key è visibile nel bundle:
# nel pannello EmailJS va attivata l'allowlist del dominio del sito e un
# limite giornaliero, altrimenti il form è usabile da chiunque a nome nostro.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# Risposta automatica a chi scrive: opzionale, si attiva riempiendola.
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=

# Invio simulato, senza chiamare EmailJS: 1 = riesce, fail = fallisce.
# Senza chiavi vale 1 in sviluppo; in produzione l'invio fallisce, perché un
# form che finge di aver spedito è peggio di uno che lo dice.
VITE_EMAILJS_MOCK=1
